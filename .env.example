# 收件地址与发信账号可以不同。请使用自己的配置。
MAIL_TO=you@example.com
MAIL_FROM=sender@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-with-your-mail-app-password

# 每小时检查；关机时本地程序无法运行。推荐服务器或常开电脑。
CHECK_INTERVAL_SECONDS=3600
TIBO_DATA_DIR=.tibo-mailer

# rules 无需模型 API；llm 使用你配置的 OpenAI 兼容 Chat Completions 接口。
# llm 模式只把相关公开帖子发给模型，不发送邮箱或发信凭据。
ANALYSIS_MODE=rules
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
